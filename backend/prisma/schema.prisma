// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  NEW
  HOT
  SALE
}

enum VariantProduct {
  GADGET
  APPLIANCES
  REFRIGERATORS
  OTHERS
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMode {
  STRIPE
  PAYPAL
  VNPAY
  MOMO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum Role {
  ADMIN
  USER
  GUEST
}


model User {
  id          String   @id @default(cuid())
  clerkUserId String?   @unique
  name        String
  email       String   @unique
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  isActive    Boolean
  updatedAt   DateTime @updatedAt
  password    String?

  orders Order[]

  @@map("user")
}

model Image {
  id String @id @default(cuid())

  secure_url String
  public_id  String @unique

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  brandId String?
  brand   Brand? @relation(fields: [brandId], references: [id], onDelete: Cascade)

  blogId String?
  blog   Blog? @relation(fields: [blogId], references: [id])

  createdAt DateTime @default(now())  

  @@map("image")
}
model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String
  price       Float
  discount    Float
  stock       Int
  status      ProductStatus  @default(NEW)
  variant     VariantProduct @default(OTHERS)
  isFeatured  Boolean        @default(false)
  brandId     String
  brand       Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)

  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id])
  images           Image[]
  isActive         Boolean           @default(true)
  fullDescription  String
  technicalDetails TechnicalDetail[]
  rating           Rating[]
  orderItems       OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([name])

  @@map("product")

}

model TechnicalDetail {
  id        String  @id @default(cuid())
  key       String
  value     String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("technical_detail")
}

model Rating {
  id          String   @id @default(cuid())
  rating      Int
  comment     String
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  clerkUserId String
  userName    String
  userEmail   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clerkUserId, productId])
  @@map("rating")
}

model Category {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  images      Image[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
  @@index([title])

  @@map("category")
}

model Brand {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  images      Image[]
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([title])

  @@map("brand")
}

model Order {
  id                String          @id @default(cuid())
  orderNumber       String          @unique
  clerkUserId       String?
  customerName      String
  email             String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMode       PaymentMode
  paymentStatus     PaymentStatus   @default(PENDING)
  totalPrice        Float
  amountDiscount    Float           @default(0)
  currency          String
  orderStatus       OrderStatus     @default(PENDING)
  addressShippingId String
  addressShipping   AddressShipping @relation(fields: [addressShippingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([orderNumber])
  @@index([clerkUserId])
  @@index([email])

  @@map("order")
}

model OrderItem {
  id       String @id @default(cuid())
  quantity Int
  price    Float

  productId String
  product   Product @relation(fields: [productId], references: [id])

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_item")
}

model AddressShipping {
  id           String @id @default(cuid())
  clerkUserId  String
  customerName String
  email        String

  address   String
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([clerkUserId])
  @@index([email])
  @@map("address_shipping")
}

model Blog {
  id    String @id @default(cuid())
  title String
  slug  String @unique

  images   Image[]
  url         String
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([title])

  @@map("blog")
}
